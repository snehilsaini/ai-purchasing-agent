# Required when DATABASE_MODE=postgres
DATABASE_URL=postgresql://purchasing:purchasing@localhost:5433/purchasing_agent

# Start with memory mode for the fastest demo setup.
DATABASE_MODE=memory

# Optional. Deterministic analysis works without an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Proposal freshness and demo clock settings
PROPOSAL_VALIDITY_MINUTES=30
